  "version": "1.0",
  "description": "Offline extraction-evaluation golden set (task §16/§17). Every model_draft claim carries the fields the extraction schema requires; evidence_quote is always a substring of source_text. Cases marked with an invented predicate must never compile.",
  "cases": [
    {
      "id": "apple-ceo-succession",
      "note": "Permanent regression case from task §41: the model's invented predicate 'new_ceo' is a *candidate*. It must resolve to has_ceo + temporal_signal=new — the invented name itself must never be stored as a predicate.",
      "source_text": "苹果的新任首席执行官是约翰·特努斯。",
      "model_draft": {
        "entities": [
          {"name": "苹果", "types": ["Organization"]},
          {"name": "约翰·特努斯", "types": ["Person"]}
        ],
        "claims": [
          {
            "subject": "苹果",
            "predicate": "new_ceo",
            "object": "约翰·特努斯",
            "claim_type": "factual",
            "polarity": "positive",
            "modality": "asserted",
            "context": {},
            "confidence": 0.9,
            "source_chunk": "chunk-1",
            "evidence_quote": "苹果的新任首席执行官是约翰·特努斯。"
          }
        ]
      },
      "expected_entities": [
        {"name": "苹果", "types": ["Organization"]},
        {"name": "约翰·特努斯", "types": ["Person"]}
      ],
      "expected_claims": [
        {"subject": "苹果", "predicate": "has_ceo", "object": "约翰·特努斯"}
      ]
    },
