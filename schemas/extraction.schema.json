{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"LLM-Wiki Knowledge Extraction v2.0",
  "type":"object",
  "additionalProperties":false,
  "required":["entities","claims","events","ideas","questions"],
  "properties":{
    "entities":{"type":"array","items":{"$ref":"#/$defs/entity"}},
    "claims":{"type":"array","items":{"$ref":"#/$defs/claim"}},
    "events":{"type":"array","items":{"$ref":"#/$defs/event"}},
    "ideas":{"type":"array","items":{"$ref":"#/$defs/idea"}},
    "questions":{"type":"array","items":{"$ref":"#/$defs/question"}}
  },
  "$defs":{
    "entityType":{"type":"string","enum":["Person","Organization","Product","Software","Technology","Method","Concept","Theory","Dataset","Model","Standard","Protocol","Resource","Location"]},
    "entity":{"type":"object","additionalProperties":false,"required":["name","types","aliases"],"properties":{"name":{"type":"string","minLength":1},"types":{"type":"array","items":{"$ref":"#/$defs/entityType"},"minItems":1,"uniqueItems":true},"aliases":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},"description":{"type":["string","null"]},"properties":{"type":"object"}}},
    "claimType":{"type":"string","enum":["factual","definitional","causal","comparative","evaluative","predictive","normative","hypothetical"]},
    "polarity":{"type":"string","enum":["positive","negative"]},
    "modality":{"type":"string","enum":["asserted","possible","probable","capable","necessary","recommended"]},
    "temporalSignal":{"type":["string","null"],"enum":["new","current","former","previous","prior","existing","next","future","upcoming","incoming","outgoing","successor","predecessor","past","interim","acting","designated",null]},
    "claim":{"type":"object","additionalProperties":false,"required":["subject","predicate","claim_type","polarity","modality","context","confidence","source_chunk","evidence_quote"],"properties":{"subject":{"type":"string","minLength":1},"predicate":{"type":"string","pattern":"^[a-z][a-z0-9_]*$"},"object":{"type":["string","null"]},"object_kind":{"type":["string","null"],"enum":["entity","concept","literal","unknown",null]},"temporal_signal":{"$ref":"#/$defs/temporalSignal"},"claim_type":{"$ref":"#/$defs/claimType"},"polarity":{"$ref":"#/$defs/polarity"},"modality":{"$ref":"#/$defs/modality"},"content":{"type":["string","null"]},"context":{"type":"object"},"confidence":{"type":"number","minimum":0,"maximum":1},"source_chunk":{"type":"string","minLength":1},"evidence_quote":{"type":"string","minLength":1}}},
    "time":{"type":"object","additionalProperties":false,"required":["start","end","precision"],"properties":{"start":{"type":["string","null"]},"end":{"type":["string","null"]},"precision":{"type":"string","enum":["exact","day","month","year","range","relative","unknown"]}}},
    "event":{"type":"object","additionalProperties":false,"required":["event_type","description","participants","time","location","status","confidence","source_chunk","evidence_quote"],"properties":{"event_type":{"type":"string","enum":["creation","development","release","publication","deployment","acquisition","merger","migration","training","evaluation","experiment","update","decision","announcement","meeting","failure","incident","other"]},"description":{"type":"string","minLength":1},"participants":{"type":"array","items":{"type":"string"}},"time":{"$ref":"#/$defs/time"},"location":{"type":["string","null"]},"status":{"type":"string","enum":["planned","ongoing","completed","cancelled","failed","unknown"]},"confidence":{"type":"number","minimum":0,"maximum":1},"source_chunk":{"type":"string","minLength":1},"evidence_quote":{"type":"string","minLength":1}}},
    "idea":{"type":"object","additionalProperties":false,"required":["content","status","confidence","source_chunk","evidence_quote"],"properties":{"content":{"type":"string","minLength":1},"status":{"type":"string","enum":["candidate","accepted","implemented","rejected","archived"]},"confidence":{"type":"number","minimum":0,"maximum":1},"source_chunk":{"type":"string","minLength":1},"evidence_quote":{"type":"string","minLength":1}}},
    "question":{"type":"object","additionalProperties":false,"required":["content","question_type","status","confidence","source_chunk","evidence_quote"],"properties":{"content":{"type":"string","minLength":1},"question_type":{"type":"string","enum":["knowledge","research","design","implementation","evaluation"]},"status":{"type":"string","enum":["open","answered","partially_answered","resolved","rejected","archived"]},"confidence":{"type":"number","minimum":0,"maximum":1},"source_chunk":{"type":"string","minLength":1},"evidence_quote":{"type":"string","minLength":1}}}
  }
}
